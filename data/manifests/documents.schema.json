{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/it-support-agent/documents.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot", "documents"],
  "properties": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at", "license_policy"],
      "properties": {
        "id": {"const": "m2-corpus-v1"},
        "created_at": {"type": "string", "format": "date-time"},
        "license_policy": {"const": "self-authored-only"}
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_key", "version_label", "title", "path", "media_type",
          "authority", "language", "visibility", "department_key", "effective_at",
          "expires_at", "checksum", "source", "license"
        ],
        "properties": {
          "document_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version_label": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
          "title": {"type": "string", "minLength": 3},
          "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]+\\.md$"},
          "media_type": {"const": "text/markdown"},
          "authority": {"enum": ["it", "security", "engineering"]},
          "language": {"enum": ["vi", "en", "vi-en"]},
          "visibility": {"enum": ["company", "department", "it_only"]},
          "department_key": {"type": ["string", "null"], "minLength": 3},
          "effective_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "owner", "url"],
            "properties": {
              "kind": {"const": "self-authored"},
              "owner": {"const": "it-support-agent-platform"},
              "url": {"type": "null"}
            }
          },
          "license": {"const": "CC-BY-4.0"}
        }
      }
    }
  }
}
