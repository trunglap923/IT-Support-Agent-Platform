# Configuration contract. Runtime validation was introduced in WP-01.
# Copy to an ignored .env for local development. Never commit real secrets.
# Empty connection strings/keys must be configured for the selected environment.

APP_ENV=development
DEMO_MODE=true
AI_PROVIDER=fake

POSTGRES_DB=it_support_agent
POSTGRES_USER=it_support_agent
# Local development placeholder only; replace it in .env and never reuse in production.
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://it_support_agent:local-dev-only-change-me@127.0.0.1:5432/it_support_agent
MIGRATION_DATABASE_URL=postgresql+psycopg://it_support_agent:local-dev-only-change-me@127.0.0.1:5432/it_support_agent
# Test-only URL for the opt-in LangGraph checkpoint recovery spike.
CHECKPOINT_DATABASE_URL=
REDIS_URL=
DOCUMENT_STORAGE_PATH=/data/documents
DEMO_SEED_PASSWORD=

# Baseline copied from plan.md section 16, not a claim of verified API access.
# Set AI_PROVIDER=openai only for explicit live runs; it requires OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Additional opt-in required by `make spike-openai-live`; never enable in CI.
RUN_OPENAI_LIVE_SPIKE=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
APP_AI_DAILY_BUDGET_USD=1
APP_AI_MONTHLY_BUDGET_USD=10

# Optional for fake-mode tests; real trace demo needs a configured project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LOG_PROMPTS=false
