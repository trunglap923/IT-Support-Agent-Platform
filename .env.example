# Configuration contract. Runtime validation was introduced in WP-01.
# Copy to an ignored .env for local development. Never commit real secrets.
# Empty connection strings/keys must be configured for the selected environment.

APP_ENV=development
DEMO_MODE=true
TEXT_PROVIDER=fake
AGENT_RUNTIME=auto
EMBEDDING_PROVIDER=fake
# BuildKit secret only; the CA bundle is never copied into an image layer.
HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

POSTGRES_DB=it_support_agent
POSTGRES_USER=it_support_agent
# Local development placeholder only; replace it in .env and never reuse in production.
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=postgresql+asyncpg://it_support_agent:local-dev-only-change-me@127.0.0.1:5432/it_support_agent
MIGRATION_DATABASE_URL=postgresql+psycopg://it_support_agent:local-dev-only-change-me@127.0.0.1:5432/it_support_agent
# Must be an admin connection capable of creating disposable test databases.
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://it_support_agent:local-dev-only-change-me@127.0.0.1:5432/it_support_agent
# Test-only URL for the opt-in LangGraph checkpoint recovery spike.
CHECKPOINT_DATABASE_URL=
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# Dedicated disposable Redis DB used only by opt-in integration tests.
TEST_REDIS_URL=redis://127.0.0.1:6379/15
READINESS_TIMEOUT_SECONDS=2
CELERY_AGENT_CONCURRENCY=2
CELERY_BACKGROUND_CONCURRENCY=1
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=300
CELERY_TASK_TIME_LIMIT_SECONDS=330
SSE_POLL_INTERVAL_SECONDS=0.1
SSE_HEARTBEAT_SECONDS=15
DOCUMENT_STORAGE_PATH=.storage/documents
# Host default; Compose uses the read-only corpus bundled at /app/seed-data.
DEMO_CORPUS_PATH=../data
DOCUMENT_MAX_PDF_BYTES=10485760
DOCUMENT_MAX_PDF_PAGES=100
DOCUMENT_MAX_EXTRACTED_TEXT_BYTES=1048576
# Shared by local demo accounts only; use at least 12 characters and never reuse elsewhere.
DEMO_SEED_PASSWORD=
SESSION_TTL_HOURS=8
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
SESSION_COOKIE_NAME=it_support_session
CSRF_COOKIE_NAME=it_support_csrf
COOKIE_SECURE=false
ALLOWED_WEB_ORIGIN=http://127.0.0.1:5173

# Baseline copied from plan.md section 16, not a claim of verified API access.
# Set either provider to openai only for explicit live runs; both use OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
CONTEXT_MODEL_LIMIT=16000
CONTEXT_RESERVED_OUTPUT_TOKENS=1200
CONTEXT_AUDIT_RETENTION_DAYS=7
OPENAI_INPUT_PRICE_PER_MILLION_USD=0.40
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=1.60
OPENAI_PRICE_VERSION=2026-09-openai-published
# Additional opt-in required by `make spike-openai-live`; never enable in CI.
RUN_OPENAI_LIVE_SPIKE=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_BRANCH_LIMIT=20
RETRIEVAL_RESULT_LIMIT=5
RETRIEVAL_RRF_K=60
RETRIEVAL_RRF_DENSE_WEIGHT=1.0
RETRIEVAL_RRF_SPARSE_WEIGHT=0.25
RETRIEVAL_RRF_EXACT_WEIGHT=0.0
RETRIEVAL_MAX_PRIMARY_CHUNKS_PER_DOCUMENT=1
# Selected on the SciFact train split, then evaluated once on the official test split.
RETRIEVAL_SPARSE_BACKEND=bm25
RETRIEVAL_RERANKER=fusion
RETRIEVAL_CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_CROSS_ENCODER_MODEL_FILE=onnx/model_quint8_avx2.onnx
RETRIEVAL_CROSS_ENCODER_CANDIDATE_LIMIT=20
RETRIEVAL_CROSS_ENCODER_TIMEOUT_SECONDS=10
RETRIEVAL_MINIMUM_EVIDENCE_SCORE=0.50
# Build backend images with the optional ONNX runtime only when testing this reranker.
INSTALL_CROSS_ENCODER=false
# Retrieval evaluation controls. Paid embedding runs require both explicit flags.
RETRIEVAL_BENCHMARK_CHUNK_TARGET_TOKENS=120
RETRIEVAL_BENCHMARK_CHUNK_OVERLAP_TOKENS=20
RETRIEVAL_BENCHMARK_EMBEDDING_PROVIDER=fake
RETRIEVAL_BENCHMARK_EVIDENCE_THRESHOLD=0.45
RUN_PAID_RETRIEVAL_BENCHMARK=false
# Public BEIR benchmark controls. Cached archives live under the ignored .cache directory.
PUBLIC_RETRIEVAL_CACHE_DIR=.cache/public-benchmarks
PUBLIC_RETRIEVAL_EMBEDDING_PROVIDER=fake
# Paid public runs require this explicit opt-in in addition to a configured OpenAI key.
RUN_PAID_PUBLIC_RETRIEVAL_BENCHMARK=false
# Paid LoCoMo memory retrieval runs use the same production embedding settings and budget ledger.
RUN_PAID_PUBLIC_MEMORY_BENCHMARK=false
EMBEDDING_INPUT_PRICE_PER_MILLION_USD=0.02
EMBEDDING_PRICE_VERSION=2026-09-plan-v1
# Paid re-index remains blocked unless this additional opt-in is true.
RUN_PAID_REINDEX=false
APP_AI_DAILY_BUDGET_USD=1
APP_AI_MONTHLY_BUDGET_USD=10

# Optional for fake-mode tests; real trace demo needs a configured project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_DEBUG=false
# Enable only when conversation content may be sent to the configured Langfuse project.
LANGFUSE_CAPTURE_CONTENT=false
# Defense in depth for OpenInference/OpenAI Agents traces. The application also enforces these.
OPENINFERENCE_HIDE_INPUTS=true
OPENINFERENCE_HIDE_OUTPUTS=true
OPENINFERENCE_HIDE_LLM_INVOCATION_PARAMETERS=true
OPENINFERENCE_HIDE_LLM_TOOLS=true
OPENINFERENCE_HIDE_EMBEDDINGS_TEXT=true
OPENINFERENCE_HIDE_EMBEDDINGS_VECTORS=true
OPENINFERENCE_HIDE_RETRIEVAL_DOCUMENTS=true
LOG_PROMPTS=false
