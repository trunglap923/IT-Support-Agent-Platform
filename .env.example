# Configuration contract only: runtime validation will be implemented in WP-01.
# Copy to an ignored .env when implementing runtime. Never commit real secrets.
# Empty connection strings/keys must be configured for the selected environment.

APP_ENV=development
DEMO_MODE=true

DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
DOCUMENT_STORAGE_PATH=/data/documents
DEMO_SEED_PASSWORD=

# Baseline copied from plan.md section 16, not a claim of verified API access.
# Fake-mode selection/validation is part of the WP-01 implementation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
APP_AI_DAILY_BUDGET_USD=1
APP_AI_MONTHLY_BUDGET_USD=10

# Optional for fake-mode tests; real trace demo needs a configured project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LOG_PROMPTS=false
