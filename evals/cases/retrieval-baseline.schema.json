{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrieval-baseline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "query", "role", "department_key", "expected_outcome",
    "expected_document_key", "expected_version_label", "forbidden_document_keys",
    "relevant_documents", "tags"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^ret-[0-9]{3}$"},
    "query": {"type": "string", "minLength": 1},
    "role": {"enum": ["employee", "it", "admin"]},
    "department_key": {"type": "string", "minLength": 1},
    "expected_outcome": {"enum": ["answered", "no_answer", "known_gap"]},
    "expected_document_key": {"type": ["string", "null"]},
    "expected_version_label": {"type": ["string", "null"]},
    "forbidden_document_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relevant_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_key", "version_label", "relevance"],
        "properties": {
          "document_key": {"type": "string", "minLength": 1},
          "version_label": {"type": "string", "pattern": "^v[0-9]+$"},
          "relevance": {"type": "integer", "minimum": 1, "maximum": 3}
        }
      }
    },
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
